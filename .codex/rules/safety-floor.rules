# Read-only HTTP probes for the live acceptance verification workflow
# (aiscr-review-live). The -w-anchored null-device shape keeps the full
# argv prefix transferable per argument, so no rule degrades to a bare
# curl stem. Broad developer HTTP grants also admit credentialed and mutating
# requests; their effects retain the applicable task-authorization gates.

prefix_rule(
    pattern = ["curl", "-s", "-o", "/dev/null", "-w"],
    decision = "allow",
    justification = "Curated working-set command; the forbidden floor still wins over this allow.",
)

prefix_rule(
    pattern = ["curl", "-s", "-D", "-"],
    decision = "allow",
    justification = "Curated working-set command; the forbidden floor still wins over this allow.",
)

prefix_rule(
    pattern = ["curl.exe", "-s", "-o", "NUL"],
    decision = "allow",
    justification = "Curated working-set command; the forbidden floor still wins over this allow.",
)

prefix_rule(
    pattern = ["curl.exe", "-s", "-D", "-"],
    decision = "allow",
    justification = "Curated working-set command; the forbidden floor still wins over this allow.",
)

# Developer working set: repository toolchains, package managers, build/test/lint
# runners, VCS and hosted-VCS writes, HTTP clients, and local container workflows. The
# forbidden floor composes most-restrictive-wins and still refuses the direct
# catastrophic shapes; generic shells, remote clients, and shell-write shapes are
# not carried. Broad live-infrastructure grants are excluded from both defaults;
# projects opt in for named environments and operations. Tool admission does not
# grant authority to deploy through an admitted runtime or script.

