    pattern = [".venv/bin/python", ".agents/scripts/setup_workstation_assistant_safety.py"],
    decision = "forbidden",
    justification = "The workstation safety port writes user-level assistant safety configuration and belongs to the operator alone; the governed session inspects and prepares, the operator applies.",
