# POSIX interpreter floor: the reserved entry points above name the Windows
# interpreter, so the POSIX interpreter allow below would otherwise reach them.

prefix_rule(
    pattern = [".venv/bin/python", ".agents/scripts/run_operator_patch.py"],
    decision = "forbidden",
    justification = "The operator-patch apply tool applies protected-surface replacements and belongs to the operator alone; the governed session stages, the operator applies.",
    match = [
        ".venv/bin/python .agents/scripts/run_operator_patch.py --label carry-only-executable-command-controls",
    ],
    not_match = [
        ".venv/bin/python .agents/scripts/setup_operator_patch.py status",
    ],
)

