{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "class", "operation", "variant", "state", "expected", "required_evidence"],
    "properties": {
      "id": {"type": "string", "minLength": 1},
      "class": {"type": "string"},
      "operation": {"enum": ["insert", "update", "delete", "scenario"]},
      "state": {"enum": ["prepared", "passed", "failed", "blocked", "unexecuted", "inapplicable"]},
      "expected": {"type": "object"},
      "required_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}
    }
  }
}
